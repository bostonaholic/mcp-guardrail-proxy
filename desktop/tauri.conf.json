{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Guardrail",
  "version": "0.3.1",
  "identifier": "com.bostonaholic.mcp-guardrail",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "MCP Guardrail", "width": 880, "height": 620, "minWidth": 560, "minHeight": 400 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": { "signingIdentity": "-" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgNjVENTcwQjdDRUMwMjU3OApSV1I0SmNET3QzRFZaZFdqSFdZd0lQam53bldMNXlGdWZ0T3lsMUhlbnJGTHlCQVp1VjFWMll1dwo=",
      "endpoints": ["https://github.com/bostonaholic/mcp-guardrail-proxy/releases/latest/download/mcp-guardrail-desktop-update.json"],
      "requireSignedVersion": true
    }
  }
}
