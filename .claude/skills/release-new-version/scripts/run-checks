#!/usr/bin/env bash
# Runs every command in the "Development" sections of README.md and desktop/README.md. The
# READMEs own the command lists, so a command added there is checked here with no edit.
#
# Usage: run-checks         (run from the repository root)
# Output: "ok <command>" per command that exits 0, then the output of the first that does not.
# Exit codes: 0 all passed; 1 a command failed or a README has no commands.
set -uo pipefail

SKILL=".claude/skills/release-new-version/SKILL.md"

# Prints the lines of the first sh code block under the "## Development" heading.
development_commands() {
  awk '
    /^## / { in_section = ($0 == "## Development") }
    in_section && /^```sh$/ { in_block = 1; next }
    in_block && /^```$/ { exit }
    in_block { print }
  ' "$1"
}

run_section() {
  local readme="$1" directory="$2" commands command output
  commands="$(development_commands "$readme")"
  if [ -z "$commands" ]; then
    echo "run-checks: no commands found in $readme (see $SKILL)" >&2
    exit 1
  fi
  while IFS= read -r command; do
    if output="$(cd "$directory" && bash -c "$command" 2>&1 </dev/null)"; then
      echo "ok $command"
    else
      echo "$output" >&2
      echo "run-checks: failed in $directory: $command (see $SKILL)" >&2
      exit 1
    fi
  done <<<"$commands"
}

run_section README.md .
run_section desktop/README.md desktop
